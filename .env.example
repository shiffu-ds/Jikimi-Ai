# Jikimi AI environment. Copy to .env (or run `make env`, which also fills random secrets).
# .env is gitignored: never commit real values.

JIKIMI_ENV=dev
JIKIMI_LOG_LEVEL=INFO

# --- server --------------------------------------------------------------
JIKIMI_DATA_DIR=data/server
# empty = SQLite in JIKIMI_DATA_DIR (lite profile); compose uses PostgreSQL:
# JIKIMI_DATABASE_URL=postgresql+psycopg://jikimi:${POSTGRES_PASSWORD}@postgres:5432/jikimi
JIKIMI_DATABASE_URL=
JIKIMI_JWT_SECRET=
JIKIMI_PUBLIC_BASE_URL=http://localhost:8000
JIKIMI_DASHBOARD_DIR=apps/dashboard/out
JIKIMI_WORKERS_INPROCESS=true
JIKIMI_COOKIE_SECURE=false
# 1.0 = plan timings (60 s / 120 s / 300 s); 0.25 compresses escalation for demos
JIKIMI_ESCALATION_SCALE=1.0
JIKIMI_VERIFY_TIMEOUT_S=20
# demo users (owner, admin, sana, akram, police) share this password; `make env` generates it
JIKIMI_DEMO_PASSWORD=

# --- optional local LLM / VLM (Ollama, OpenAI-compatible) ------------------
JIKIMI_LLM_BASE_URL=
JIKIMI_LLM_MODEL=
JIKIMI_VLM_MODEL=

# --- optional guard voice replies (F12): `uv sync --extra voice` + models/README.md; empty = off
JIKIMI_WHISPER_MODEL=models/faster-whisper-small
JIKIMI_WHISPER_THREADS=2

# --- optional Telegram escalation channel ---------------------------------
JIKIMI_TELEGRAM_BOT_TOKEN=
JIKIMI_TELEGRAM_CHAT_IDS=

# --- postgres (compose profiles) -------------------------------------------
POSTGRES_USER=jikimi
POSTGRES_PASSWORD=
POSTGRES_DB=jikimi

# --- edge --------------------------------------------------------------------
JIKIMI_SERVER_URL=http://localhost:8000
JIKIMI_EDGE_DATA_DIR=data/edge
# device token: written by `make seed` to data/edge/keys/device.token (or set here)
JIKIMI_DEVICE_TOKEN=
JIKIMI_DEVICE_KEY_PASSPHRASE=
# real cameras (sub-streams): rtsp://user:pass@192.168.1.64:554/Streaming/Channels/102
CAM_GATE_01_RTSP=
CAM_STREET_02_RTSP=
# offline SMS: comma-separated numbers; gateway = file (fake modem) | modem | none
GUARD_SMS_NUMBERS=+923001234567
JIKIMI_SMS_GATEWAY=file
JIKIMI_MODEM_PORT=/dev/ttyUSB0
