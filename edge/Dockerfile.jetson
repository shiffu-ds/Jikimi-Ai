# Jikimi AI edge image for NVIDIA Jetson (profile E2): TensorRT engines are built ON the device.
# Base image must match your JetPack release (check `cat /etc/nv_tegra_release`).
ARG L4T_BASE=nvcr.io/nvidia/l4t-jetpack:r36.4.0
FROM ${L4T_BASE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3-pip python3-venv ffmpeg \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY packages/ packages/
COPY edge/ edge/
RUN python3 -m venv /app/.venv && /app/.venv/bin/pip install --no-cache-dir ./packages/jikimi-contracts ./packages/jikimi-common \
        ./packages/jikimi-crypto ./packages/jikimi-ml-runtime ./edge
ENV PATH="/app/.venv/bin:$PATH" JIKIMI_EDGE_DATA_DIR=/data
CMD ["python", "-m", "jikimi_edge", "--config", "/app/edge/config/site.yaml", "run"]
